  "narrative": {
    "northStar": "The Institutional Service Directory",
    "overview": "An institutional service directory gives RelayDesk its visual grammar: a deep ink navigation rail, cool working ground, and white record surfaces. The Turkish interface feels calm, precise, and ready for repeated use. Information density comes from aligned columns, small supporting labels, and a restrained type hierarchy.\n\nBlue marks actions and selection. Amber, red, and green communicate operational state alongside text and symbols. The system uses locally bundled Inter Variable for continuity across forms and records; record identifiers have a separate monospace voice. Working surfaces are built from code and SVG icons, with no decorative raster imagery.",
    "keyCharacteristics": [
      "Dense, legible records and explicit Turkish labels.",
      "Ink navigation, cool ground, white working surfaces.",
      "Semantic state colors reinforced by words and symbols.",
      "Quiet borders, gently rounded controls, limited elevation."
    ],
    "rules": [
      {
        "name": "The Action Blue Rule",
        "body": "Use primary blue for actionable controls, selected choices, and linked record emphasis; reserve amber, red, and green for their operational meanings.",
        "section": "colors"
      },
      {
        "name": "The Stable Record Rule",
        "body": "Keep record identifiers, dates, SLA values, and ledger totals numerically stable with tabular figures; identifiers retain the monospace face.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Rule",
        "body": "Keep record containers flat and border-defined; use elevation for controls and modal separation rather than lifting every content block.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve visible labels, field hints, required indicators, and inline validation.",
      "Do keep operational colors paired with status words, priority labels, or SLA symbols.",
      "Do let wide tables scroll horizontally and let filters wrap on narrow screens.",
      "Do use the local Inter family, existing type hierarchy, and tabular record values.",
      "Do preserve focus rings, disabled states, and the reduced-motion override."
    ],
    "donts": [
      "Don't replace record-first working surfaces with decorative metric tiles.",
      "Don't use navigation blue as an arbitrary success, warning, or error color.",
      "Don't add ornamental imagery or metaphorical controls to routine service workflows.",
      "Don't turn flat record sections into heavily shadowed floating cards."
    ]
  }
}
